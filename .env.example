# 青陈时尚出入库 — 本地开发环境变量
# 复制本文件为 .env.local 后填入你的 Supabase 项目值

# Supabase 项目 URL（Dashboard → Project Settings → API）
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# Supabase 匿名公钥（anon / public key）
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY

# 本地开发免登录（可选）
# - 不设时：next dev 默认跳过登录，以管理员进入；next start / 上线仍需登录
# - 设为 false：本地也强制走登录页（用于自测登录流）
# DEV_BYPASS_AUTH=false

# 开发预览 Mock 假数据（可选）
# - 不设时：next dev 默认使用内存假数据，不依赖 Supabase
# - 设为 false：本地也走真实 Supabase
# NEXT_PUBLIC_USE_MOCK_DATA=false
