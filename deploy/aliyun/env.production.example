# 复制为服务器上的 /opt/qingchen-inventory/.env.production 后按需修改
# chmod 600 .env.production

NODE_ENV=production
PORT=3000
HOSTNAME=0.0.0.0

# —— Supabase（Next.js 必须用 NEXT_PUBLIC_ 前缀才会打进前端包）——
# 若你只有 SUPABASE_URL / SUPABASE_ANON_KEY，部署脚本也会自动映射到下面两行
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY

# true=内存假数据；对接真实库必须为 false
NEXT_PUBLIC_USE_MOCK_DATA=false

# 生产环境一般关闭开发免登录（不设即可）
# DEV_BYPASS_AUTH=false
